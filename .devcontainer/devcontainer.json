// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Marp Slides",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		}
		// Uncomment this feature (and add a comma above) for PDF/PPTX export.
		// "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
		// 	"packages": "chromium"
		// }
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	"postCreateCommand": "npm install --global @marp-team/marp-cli@4.5.0",
	// Run outside the workspace so host-only worktree pointers do not break startup.
	"postStartCommand": "git -C / config --global --add safe.directory \"${containerWorkspaceFolder}\"",
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"markdown.marp.diagnostics.slideContentOverflow": true,
				"markdown.marp.html": "all",
				"markdown.marp.mathTypesetting": "mathjax",
				"markdown.marp.exportType": "html",
				"markdown.marp.themes": [
					"./slides/themes/custom.css",
					"./slides/themes/custom-default.css",
					"./slides/themes/custom-devsum.css",
					"./slides/themes/custom-gaia.css",
					"./slides/themes/custom-uncover.css"
				]
			},
			"extensions": [
				"streetsidesoftware.code-spell-checker",
				"yzhang.markdown-all-in-one",
				"marp-team.marp-vscode",
				"bierner.markdown-mermaid",
				"hediet.vscode-drawio"
			]
		}
	}
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
